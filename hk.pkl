amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

// Keep the amends/import version in lockstep with the `hk` version in mise.toml,
// and only pin a version mise can actually install (`mise ls-remote hk`).
//
// wrk is a Bun + TypeScript workspace. Biome formats and lints the JS/TS/JSON;
// tsc owns types; rumdl owns Markdown; taplo owns TOML; pkl owns this file.
//
// Four lanes, plus the two git hooks that enforce them:
//   hk fix              -> the `fix` hook       -> formatters, write mode
//   hk check            -> the `check` hook     -> formatters + linters, read-only
//   hk run typecheck    -> the `typecheck` hook -> tsc alone
//   hk run test         -> the `test` hook      -> bun test alone
//   pre-commit          -> formatters + linters, fix mode
//   pre-push            -> the test step
//
// `check` runs the formatters in read-only mode alongside the linters, so an
// unformatted file fails the gate instead of being silently reflowed at commit
// time. The tsc and bun-test steps are declared once below and referenced from
// every hook that needs them.

// tsc is a dev dependency rather than a mise tool, so it runs through bun. It is
// a whole-program check: no `{{ files }}` argument, so a matching staged file
// just triggers the full check once.
local tscStep = new Step {
  glob = List("**/*.ts")
  exclude = List("node_modules/**")
  check = "bun x tsc --noEmit -p tsconfig.json"
}

// Likewise whole-suite: bun discovers its own test files.
local testStep = new Step {
  glob = List("**/*.ts")
  exclude = List("node_modules/**")
  check = "bun test"
}

// Formatters — rewrite files into canonical form.
local formatters = new Mapping<String, Step> {
  // `biome check` (not `biome format`) so this step also applies the
  // organizeImports assist action configured in biome.jsonc — import grouping is
  // a formatting concern and rides with the formatter. `--linter-enabled=false`
  // keeps lint rules and their autofixes out of the format pass; the read-only
  // Web(Lint) step below owns those. hk's glob is broader than biome.jsonc's
  // `files.includes`, so a staged file can land outside biome's scope;
  // --no-errors-on-unmatched lets it no-op instead of failing the hook.
  ["Web(Format)       [[biome]]"] = new Step {
    glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.json", "**/*.jsonc")
    check = "biome check --linter-enabled=false --no-errors-on-unmatched {{ files }}"
    fix = "biome check --write --linter-enabled=false --no-errors-on-unmatched {{ files }}"
  }

  // rumdl owns Markdown — one binary for both roles. `rumdl fmt` applies fixes
  // with formatter-style exit codes, so it won't fail on leftover lint; the
  // Markdown(Lint) step below enforces read-only `rumdl check`. Only `fix` is
  // overridden — the builtin's glob and check_diff are inherited.
  ["Markdown(Format)  [[builtins.rumdl]]"] = (Builtins.rumdl) {
    fix = "rumdl fmt {{ files }}"
  }

  ["TOML(Format)      [[builtins.taplo_format]]"] = Builtins.taplo_format

  ["Pkl(Format)       [[builtins.pkl_format]]"] = Builtins.pkl_format
}

// Linters — read-only checks that never rewrite.
local linters = new Mapping<String, Step> {
  // --error-on-warnings makes warn-level rules fail the gate instead of printing
  // and exiting 0. `fix` omits it so autofix still runs and never aborts on a
  // warning it can't rewrite.
  ["Web(Lint)         [[biome]]"] = new Step {
    glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs")
    check = "biome lint --error-on-warnings --no-errors-on-unmatched {{ files }}"
    fix = "biome lint --write --no-errors-on-unmatched {{ files }}"
  }

  ["TypeScript(Check) [[tsc]]"] = tscStep

  // Same rumdl binary, read-only: `rumdl check` reports violations (exit 1). In
  // pre-commit (fix = true) the inherited `rumdl check --fix` auto-resolves
  // fixable lint after the formatter's `rumdl fmt`, so a commit converges in one pass.
  ["Markdown(Lint)    [[builtins.rumdl]]"] = (Builtins.rumdl) {
    check = "rumdl check {{ files }}"
  }

  ["TOML(Lint)        [[builtins.taplo]]"] = Builtins.taplo

  // pkl lints by evaluating the file, which resolves the remote amends/import
  // package (cached after the first run).
  ["Pkl(Lint)         [[builtins.pkl]]"] = Builtins.pkl
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
    }
  }

  // Tests are too slow for pre-commit; they gate the push instead.
  ["pre-push"] {
    steps = new Mapping<String, Step> {
      ["Test(Bun)         [[bun]]"] = testStep
    }
  }

  // The format lane — formatters only, in write mode.
  ["fix"] {
    fix = true
    steps = formatters
  }

  // The lint lane — formatters + linters, read-only. The hook sets no `fix`, so
  // each formatter runs its `check` command alongside the rule and type checks.
  // This makes `check` agree with `fix` on formatting: an unformatted file fails
  // the gate here instead of being silently reflowed by the pre-commit fix.
  ["check"] {
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
    }
  }

  // The typecheck lane, run on its own: `hk run typecheck`.
  ["typecheck"] {
    steps = new Mapping<String, Step> {
      ["TypeScript(Check) [[tsc]]"] = tscStep
    }
  }

  // The test lane, run on its own: `hk run test`.
  ["test"] {
    steps = new Mapping<String, Step> {
      ["Test(Bun)         [[bun]]"] = testStep
    }
  }
}
