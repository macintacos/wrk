{
  // One type-check program spans the whole workspace: both packages are
  // Node/Bun terminal code, so there is no second target to split a base config
  // out for. When a differently-targeted build arrives (EXC-986), that build's
  // config extends this one rather than duplicating it.
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "types": ["bun"]
  },
  // `.tsx` is in scope from the start even though no component exists yet: the
  // picker is built on Ink, whose components are `.tsx`, and a file the type
  // checker silently skips is a worse failure than one it loudly rejects. No
  // `jsx` option until a package actually pulls in React — its absence is that
  // loud rejection.
  // Listed extension by extension: TypeScript's include globs support `*`, `?`
  // and `**/`, but not brace expansion — `*.{ts,tsx}` matches nothing at all.
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "dist"]
}
